[{"abstract":"State-separating proofs are a powerful tool to structure cryptographic arguments, so that they are amenable for mechanization, as has been shown through implementations, such as SSProve. However, the treatment of separation for heaps has never been satisfactorily addressed. In this work, we present the first comprehensive treatment of nominal state separation in state-separating proofs using nominal sets. We provide a Rocq library, called Nominal-SSProve, that builds on nominal state separation supporting mechanized proofs that appear more concise and arguably more elegant.","author_count":2,"contributors":["Larsen, Markus Krabbe","Schürmann, Carsten"],"cuid":["S01-000.00-861021"],"event":{"end":"2025-06-20","place":"Santa Cruz, us","start":"2025-06-16","title":"Computer Security Foundations Symposium","year":"2025"},"filters":{"added":"2026-07","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Coq","Formal verification","Nominal sets","State separating proofs"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"nominal state separating proofs","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"http://dx.doi.org/10.1109/csf64896.2025.00038","version":"Other Version"},"funding_acknowledgement":["This work is supported by the Innovation Fund Denmark for the project DIREC (9142-00001B)."],"id":"S01-000.00-861021","identifier":[{"id":"105014722876","type":"scopus"}],"ids":["itu-7a377e33-676b-4475-90cb-403c95160c3f"],"keyword":["Coq","Formal verification","Modular cryptographic proofs","Nominal sets","State-separating proofs"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-2-2A4B10B3286A344AA8AD20A2C548D328"],"org":[{"affno":"1","key":"itu it univer