{"abstract":"This is a conversation between Gopinaath Kannabiran and Anna Brynskov who both work in Sexuality and HCI. They discuss intersections between theoretical outsets from critical disability, cyberfeminism and ecofeminism. Brynskov’s prototype is presented side by side with a vision for future design research in disability spheres and in regards to materials for breathing together.","author_count":2,"contributors":["Kannabiran, Gopinaath","Brynskov, Anna"],"cuid":["S01-000.00-798525"],"filters":{"added":"2025-04","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["America, North","OECD"],"country":["United States"],"glorg":["All Global Affiliations","Pratt Institute"],"keyword":["Cyberfeminism","Ecofeminism"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"sex disability and hci","src":["itu"],"src-code":["DI-U-ITU"],"type":"dja","type-grp":["all","pub"]},"id":"S01-000.00-798525","identifier":[{"id":"85217237236","type":"scopus"}],"ids":["itu-1e299c0a-d3e0-48f1-a332-034868a0ec54"],"keyword":["Critical Disability","Cyberfeminism","Design Research in Disability","Ecofeminism","Sexuality and HCI"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-2-C19DB5F61CD0EC43BB42F3C9C64E9C99"],"org":[{"affno":"1","country":"us","key":"pratt institute","loc":["United States","America, North","OECD"],"name":"Pratt Institute","used":1},{"affno":"2","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Human-Computer Interaction and Design"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"