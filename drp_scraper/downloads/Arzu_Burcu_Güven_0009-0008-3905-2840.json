[{"abstract":"We examine the syntactic properties of BabyLM corpus, and age-groups within CHILDES. While we find that CHILDES does not exhibit strong syntactic differentiation by age, we show that the syntactic knowledge about the training data can be helpful in interpreting model performance on linguistic tasks. For curriculum learning, we explore developmental and several alternative cognitively inspired curriculum approaches. We find that some curricula help with reading tasks, but the main performance improvement come from using the subset of syntactically categorizable data, rather than the full noisy corpus.","author_count":17,"contributors":["Güven, Arzu Burcu","Rogers, Anna","van der Goot, Rob"],"cuid":["S01-000.00-860903"],"event":{"end":"2025-11-09","place":"Suzhou, cn","start":"2025-11-05","title":"Workshop on BabyLM","year":"2025"},"filters":{"added":"2026-07","altsrc":["No Matches Found"],"author_count":"11-50 contributors","cluster_size":1,"keyword":["Curriculum learning"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"do syntactic categories help in developmentally motivated curriculum learning for language models","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.18653/v1/2025.babylm-main.22","version":"Published Version"},"id":"S01-000.00-860903","ids":["itu-2683ff21-33d2-4a8d-a409-d9f233b193e5"],"keyword":["BabyLM corpus","CHILDES corpus","Curriculum learning","Language model evaluation","Syntactic development"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-ADA59D003826A662E28886C073611876"],"oa_link":[{"access":"oa","type":"rem","url":"https://aclanthology.org/2025.babylm-main.22.pdf","version":"Published Version"},{"access":"oa","license":