{"abstract":"This issue's contributions highlight the impact and educational value of the qualitative and quantitative analysis papers. Enjoy reading! While I will keep inviting members of the data management community, and neighboring communities, to contribute to this column, I also welcome unsolicited contributions. Please contact me if you are interested.","author_count":2,"contributors":["Braganholo, Vanessa","Hentschel, Martin"],"cuid":["S01-000.00-860866"],"filters":{"added":"2026-07","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["America, South"],"country":["Brazil"],"glorg":["All Global Affiliations","Federal Fluminense University"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"reminiscences on influential papers","src":["itu"],"src-code":["DI-U-ITU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"Ikke-specificeret","type":"doi","url":"https://doi.org/10.1145/3712311.3712317","version":"Published Version"},"id":"S01-000.00-860866","ids":["itu-0f07a122-75bf-47a2-826d-d2e23e0f8fc5"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-6-6-F9A12B07967D3228250B6783DCBF16A2"],"oa_link":[{"access":"oa","license":"Ikke-specificeret","type":"doi","url":"https://doi.org/10.1145/3712311.3712317","version":"Published Version"},{"access":"oa","license":"CC BY","type":"rem","url":"https://dl.acm.org/doi/epdf/10.1145/3712311.3712317","version":"Published Version"}],"oai":{"class":"Blocked","mra":["Science / Technology (SCI)"],"yearPub":"2025","yearSub":"2024"},"org":[{"affno":"1","country":"br","key":"federal fluminense university","loc":["Brazil","America, South"],"name":"Federal Fluminense University","used":1},{"affno":"2","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":