rsity of Copenhagen","namevar":["IT University of Copenhagen, Play, Culture, and AI"],"nora_code":"DI-U-ITU","used":1},{"affno":"3","country":"gb","key":"university of bristol","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"University of Bristol","used":1}],"person":[{"affno":"1 2 3","corresponding":null,"country":"dk","first":"Feng","key":"fengpau","last":"Feng","locid":"6c8806c3-bb14-43f5-9656-f526905eeb4b","name":"Feng, Feng","orcid":"0000-0002-7127-5437","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Elisa D.","key":"meklerpau","last":"Mekler","locid":"cf6cfa0b-e3ac-4164-8de2-b956d8e23825","name":"Mekler, Elisa","name_org":"Mekler, Elisa D.","orcid":"0000-0003-0076-6703","rank":2,"rolecode":"pau"}],"pub":{"doi":"10.1145/3689050.3704419","eisbn":["979840071197"],"isbn":["9798400711978"],"pages":"1-13","publisher":"Association for Computing Machinery","status":"p","title":"TEI '25: Proceedings of the Nineteenth International Conference on Tangible, Embedded, and Embodied Interaction"},"review":"Peer Reviewed","scoID":["2-s2.0-105000290959"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["au-dffc5ddb-d1f0-4a02-a767-095b4081016e","itu-8422b28e-a122-4c3b-847d-13c716bae1e0"],"src":["AU Aarhus University","ITU IT University of Copenhagen"],"title":"Thermal Cards: From Classical Chinese Poetry to Designerly Lenses on Thermal-Affective Technology","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-081.90-835208","year":"2025","yearsub":"2025"}
{"abstract":"Much work in HCI has investigated strategies for supporting autonomous self-regulation in social media use (SMU): helping users to control their time online and ensure it serves personally valued outcomes. However, results suggest that the effectiveness and acceptability of these strategies may vary based on individual needs. Recent work has attributed this variation to motivational factors, though we currently lack data to understand how these factors influence self-regulation, user experience and well-being. We draw on Self-Determination Theory to analyse autonomous and non-autonomous patterns of motivation in 521 users of social media. Using latent profile analysis, we identify 4 \"motivational profiles\"associated with significant differences in need satisfaction, affect, and compulsive engagement. Our results clarify distinct aspects of autonomy in SMU and identify opportunities to target and personalise design interventions; they suggest autonomous regulation can be associated with better experience and well-being, though not necessarily less time online.","author_count":3,"contributors":["Bennett, Daniel","Feng, Feng","Mekler, Elisa"],"cuid":["S01-000.00-852050"],"filters":{"added":"2026-07","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Europe, Non-EU","OECD"],"country":["United Kingdom"],"glorg":["All Global Affiliations","University of Bristol"],"keyword":["Autonomy","Internalisation","Motivation","Self control","Self determination theory","Self regulation","Social media"],"level":"sci","mra":["hum"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU","DI-U-ITU"]},"level3all":["DI-U-AU","DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"autonomous regulation of social media use implications for self control well being and ux","src":["au"],"src-code":["DI-U-AU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi",