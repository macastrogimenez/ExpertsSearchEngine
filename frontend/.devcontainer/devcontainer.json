{
  "name": "Experts Search Frontend",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspaces/frontend,type=bind",
  "workspaceFolder": "/workspaces/frontend",
  "remoteUser": "node",
  "mounts": [
    "source=${devcontainerId}-node_modules,target=/workspaces/frontend/node_modules,type=volume"
  ],
  "postCreateCommand": "mkdir -p /home/node/.codex && sudo chown node:node node_modules && npm ci",
  "forwardPorts": [5173],
  "portsAttributes": {
    "5173": {
      "label": "Vite frontend",
      "onAutoForward": "notify"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": ["dbaeumer.vscode-eslint", "bradlc.vscode-tailwindcss"]
    }
  }
}
